# For a container or compose workflow only.
#
# No TallyOwl service reads a .env file. That convention belongs to a container
# runtime and it hides precedence, so the binary workflow uses a configuration
# file plus real environment variables. See docs/CONVENTIONS.md section 5.
#
# Copy this to `.local.env`, which Git ignores. This file holds no secret and
# documents every key.

# A secret is a reference, never a value. The reference points at a file the
# container mounts or at another environment variable.
TALLYOWL_COLLECTOR__API_KEY=

# The durable store. `group` and `always` are the only flush modes TallyOwl
# starts against; `interval` and `never` acknowledge writes that a power loss
# can destroy.
TALLYOWL_CORNDOGS__ENDPOINT=corndogs:5080
TALLYOWL_CORNDOGS__FSYNC_MODE=group

# Where each service listens inside the container network.
TALLYOWL_COLLECTOR__LISTEN=0.0.0.0:5100
TALLYOWL_COLLECTOR__OPERATIONAL_LISTEN=0.0.0.0:5101
TALLYOWL_HEAD__LISTEN=0.0.0.0:5110
TALLYOWL_HEAD__OPERATIONAL_LISTEN=0.0.0.0:5111
TALLYOWL_HEAD__ENDPOINT=head:5110

TALLYOWL_HEAD__DATA_DIR=/var/lib/tallyowl/head
TALLYOWL_LOG__LEVEL=info
