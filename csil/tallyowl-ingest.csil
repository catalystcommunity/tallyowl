;;; TallyOwl ingest contract.
;;;
;;; An application INCLUDES this specification in its own CSIL build. The
;;; generated TallyOwl service joins the application's existing router, and
;;; browser telemetry travels on the connection the application already has.
;;;
;;; A browser never opens a TallyOwl connection and never contacts a TallyOwl
;;; domain. See AGENTS.md, "Protocol boundaries".
;;;
;;; Every package that csilgen can emit is listed. A generated client is free.
;;; A maintained app driver is not, and the project maintains three. See the
;;; client library rollout in docs/PLAN.md.

include "types/common.csil"

options {
    package: "tallyowl-ingest",
    version: "v1alpha1",
    emit_packages: ["rust", "go", "typescript"],
    package_name: "tallyowl-ingest-api",
    go_module: "github.com/CatalystCommunity/tallyowl/generated/go/tallyowl-ingest-api",
    package_version: "0.2.0",
    decimal_mapping: "csil"
}

;; ---------------------------------------------------------------------------
;; Payloads
;; ---------------------------------------------------------------------------

;;; A named product or behavior event.
EventPayload = {
    name: text .size (1..128),
    ? route: text .size (1..512),
    ? page_title: text .size (1..512)
}

;;; A page view or a screen view.
PageViewPayload = {
    route: text .size (1..512),
    ? page_title: text .size (1..512),
    ? referrer: text .size (1..1024),
    ? campaign: CampaignParameters
}

CampaignParameters = {
    ? source: text .size (1..128),
    ? medium: text .size (1..128),
    ? campaign: text .size (1..128),
    ? term: text .size (1..128),
    ? content: text .size (1..128),
    ? click_id: text .size (1..256)
}

;;; The session lifecycle works on every surface, including a terminal user
;;; interface. The client library issues the ID. See D11.
SessionStartPayload = {
    ? entry_route: text .size (1..512)
}

SessionEndPayload = {
    reason: "explicit" / "timeout" / "maximum-lifetime"
}

InteractionPayload = {
    target: text .size (1..256),        ;; a semantic name, never a DOM selector
    action: text .size (1..64)
}

FeatureExposurePayload = {
    feature: text .size (1..128),
    variant: text .size (1..128)
}

IdentifyPayload = {
    end_user_id: text .size (1..256)
}

AliasPayload = {
    from_id: text .size (1..256),
    to_id: text .size (1..256)
}

GroupPayload = {
    group_id: text .size (1..256),
    ? group_kind: text .size (1..64)
}

;;; A conversion carries an exact decimal value. It never uses a float.
;;;
;;; `order_id` is what makes a conversion idempotent. A checkout that retried,
;;; a webhook that arrived twice, and a person who refreshed the receipt page
;;; all produce the same order. TallyOwl counts one conversion and one value for
;;; one `goal` and `order_id` pair, and keeps the earliest. A conversion without
;;; an order identifier is its own event and is never folded into another.
;;;
;;; `campaign` and `touch_event_id` are the optional links DATA_MODEL.md
;;; section 3.6 describes. An application that already knows which touch earned
;;; a conversion says so; attribution uses the link and does not have to find
;;; the touch again.
ConversionPayload = {
    goal: text .size (1..128),
    ? value: decimal,
    ? currency: text .size (3..3),
    ? order_id: text .size (1..128),
    ? campaign: CampaignParameters,
    ? touch_event_id: EventId
}

;; ---------------------------------------------------------------------------
;; Errors
;;
;; The producer never supplies a group. The projector computes the fingerprint
;; from these inputs and can rebuild every group at a new version. See D39.
;; ---------------------------------------------------------------------------

StackFrame = {
    ? module: text .size (1..256),
    ? function: text .size (1..256),
    ? file: text .size (1..512),
    ? line: uint,
    in_app: bool
}

ErrorPayload = {
    error_type: text .size (1..256),
    message: text .size (1..2048),
    handled: bool,
    severity: "fatal" / "error" / "warning" / "info",
    ? mechanism: text .size (1..64),
    ? runtime: text .size (1..128),
    ? frames: [* StackFrame],
    ? breadcrumbs: [* EventId]
}

;; ---------------------------------------------------------------------------
;; Spans
;;
;; The collector applies head sampling and always-keep rules. The head applies
;; tail sampling after commit, because trace ID routing already co-locates a
;; trace on one tablet. See D35.
;; ---------------------------------------------------------------------------

SpanKind = "internal" / "server" / "client" / "producer" / "consumer"

SpanLink = {
    trace_id: TraceId,
    span_id: SpanId
}

SpanPayload = {
    operation: text .size (1..256),
    kind: SpanKind,
    start_at: Timestamp,
    duration_ms: DurationMs,
    status: "ok" / "error" / "unset",
    ? resource: text .size (1..256),
    ? parent_span_id: SpanId,
    ? links: [* SpanLink],
    ? error_event_id: EventId,
    ? sampling_reason: text .size (1..64)
}

;; ---------------------------------------------------------------------------
;; Metrics
;; ---------------------------------------------------------------------------

MetricKind = "counter" / "gauge" / "histogram"

HistogramValue = {
    count: uint,
    sum: float,
    bounds: [* float],
    counts: [* uint]
}

MetricPointPayload = {
    metric_name: text .size (1..256),
    metric_kind: MetricKind,
    ? unit: text .size (1..32),
    ? description: text .size (1..512),
    monotonic: bool,
    temporality: "delta" / "cumulative",
    start_at: Timestamp,
    end_at: Timestamp,
    labels: PropertyList,
    ? number_value: float,
    ? histogram_value: HistogramValue,
    ? exemplar_trace_id: TraceId
}

;; ---------------------------------------------------------------------------
;; Campaigns
;; ---------------------------------------------------------------------------

;;; One touch. DATA_MODEL.md section 3.6 lists what it records, and every
;;; field here is one of them. Two are absent on purpose:
;;;
;;;   - the **channel classification and its classifier version** are derived
;;;     from `campaign` and `referrer_domain` rather than sent. A producer that
;;;     could name its own channel could put paid traffic in the organic column;
;;;   - **first and last touch position** is a property of the set of touches a
;;;     conversion looked back over, not of one touch. It is decided when the
;;;     question is asked.
;;;
;;; `referrer` is the whole referring address and `referrer_domain` is the host
;;; from it. Both travel because a classifier reads the host and a person
;;; reading one touch wants the address.
CampaignTouchPayload = {
    campaign: CampaignParameters,
    ? referrer: text .size (1..1024),
    ? referrer_domain: text .size (1..256),
    ? landing_route: text .size (1..512)
}

CampaignCostPayload = {
    campaign: text .size (1..128),
    ? platform: text .size (1..128),
    cost: decimal,
    currency: text .size (3..3),
    period_start: Timestamp,
    period_end: Timestamp
}

;; ---------------------------------------------------------------------------
;; The telemetry item
;;
;; One envelope, one typed payload. `envelope.kind` selects the payload field,
;; and exactly one payload field is present.
;;
;; An earlier draft made the payload a choice of the fifteen record types. A
;; choice dispatches on the runtime type of the value, and every one of those
;; fifteen is one JavaScript object, so a TypeScript client encoded a page view,
;; an error, and a span all as the first arm. The whole browser package was
;; unable to send anything but an event.
;;
;; The envelope already carried the discriminant. This shape uses it, instead of
;; asking an encoder to recover it from a shape that does not carry one. See
;; docs/IMPLEMENTATION_LOG.md L017.
;;
;; `session-heartbeat` has no payload field, because a heartbeat carries no data
;; beyond its envelope.
;; ---------------------------------------------------------------------------

TelemetryItem = {
    envelope: Envelope,
    ? event: EventPayload,
    ? page_view: PageViewPayload,
    ? session_start: SessionStartPayload,
    ? session_end: SessionEndPayload,
    ? interaction: InteractionPayload,
    ? feature_exposure: FeatureExposurePayload,
    ? identify: IdentifyPayload,
    ? alias: AliasPayload,
    ? group: GroupPayload,
    ? conversion: ConversionPayload,
    ? error: ErrorPayload,
    ? span: SpanPayload,
    ? metric_point: MetricPointPayload,
    ? campaign_touch: CampaignTouchPayload,
    ? campaign_cost: CampaignCostPayload
}

;; ---------------------------------------------------------------------------
;; Operations
;;
;; `capture` is best effort from the browser to its own application. It returns
;; when the application accepts the frame. It makes no durability claim, and it
;; never blocks on the remote head. See DELIVERY.md section 1.
;;
;; `capture-critical` exists for a host that wants the browser to wait for the
;; same durable boundary that a backend batch waits for. A host chooses whether
;; to expose it. See D5.
;; ---------------------------------------------------------------------------

CaptureRequest = {
    items: [* TelemetryItem]
}

CaptureResponse = {
    accepted: uint,
    ? rejected: [* RejectedItem]
}

RejectedItem = {
    event_id: EventId,
    code: ErrorCode,
    message: text
}

CaptureCriticalRequest = {
    items: [* TelemetryItem]
}

CaptureCriticalResponse = {
    accepted: uint,
    durable: bool,
    ? batch_id: BatchId,
    ? rejected: [* RejectedItem]
}

;;; A policy snapshot version that the client holds. The application can pass a
;;; newer snapshot to the browser package over its own connection.
PolicyVersionRequest = {}

PolicyVersionResponse = {
    policy_version: uint,
    sampling_rate: float,
    enabled_kinds: [* TelemetryKind]
}

@wire-id(1)
service TallyOwlIngest {
    ;;; Accept telemetry on the application's existing connection. Best effort.
    @wire-id(0)
    capture: CaptureRequest -> CaptureResponse / ServiceError,

    ;;; Accept telemetry and wait for the collector durability boundary.
    @wire-id(1)
    capture-critical: CaptureCriticalRequest -> CaptureCriticalResponse / ServiceError,

    ;;; Report the collection policy that the client must apply.
    @wire-id(2)
    policy-version: PolicyVersionRequest -> PolicyVersionResponse / ServiceError
}
